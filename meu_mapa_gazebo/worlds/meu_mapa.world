<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- Luz do sol -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Sun</uri>
    </include>

    <!-- Plano do chao -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Ground Plane</uri>
    </include>

    <!-- Modelo open_map -->
    <include>
      <uri>model://open_map</uri>
      <name>open_map</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Modelo base -->
    <include>
      <uri>model://base</uri>
      <name>base</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
