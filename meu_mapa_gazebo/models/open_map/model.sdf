<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="open_map">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://open_map/meshes/open_map.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://open_map/meshes/open_map_col.stl</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
