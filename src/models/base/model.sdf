<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="base">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <cast_shadows>true</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://base/meshes/base.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://base/meshes/base_col.stl</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
